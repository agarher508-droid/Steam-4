<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Préstamo Material STEAM - CEIP Toxiria</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/html5-qrcode"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    body { background-color: #0f172a; color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
    .nav-active { color: #38bdf8; border-top: 2px solid #38bdf8; }
    #reader video { border-radius: 0.75rem; object-fit: cover; width: 100% !important; height: 100% !important; }
  </style>
</head>
<body class="pb-20 max-w-md mx-auto min-h-screen relative border-x border-slate-800 shadow-2xl">

  <header class="bg-slate-900 border-b border-slate-800 p-4 sticky top-0 z-50 flex items-center justify-between">
    <div class="flex items-center space-x-3">
      <div class="bg-sky-500 text-slate-950 p-2 rounded-xl font-bold">
        <i class="fa-solid fa-microchip text-xl"></i>
      </div>
      <div>
        <h1 class="font-bold text-base leading-tight">STEAM Toxiria</h1>
        <p class="text-xs text-slate-400">CEIP Toxiria · Préstamos & Aula</p>
      </div>
    </div>
    <span class="bg-emerald-500/10 text-emerald-400 text-xs px-2.5 py-1 rounded-full border border-emerald-500/20 font-medium">Versión Estable</span>
  </header>

  <main id="app-content" class="p-4 space-y-4"></main>

  <nav class="fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-md bg-slate-900/95 backdrop-blur border-t border-slate-800 flex justify-around py-2 z-50 text-slate-400 text-xs">
    <button onclick="switchTab('scanner')" id="nav-scanner" class="flex flex-col items-center py-1 px-3 space-y-1 nav-active">
      <i class="fa-solid fa-qrcode text-lg"></i>
      <span>Escáner</span>
    </button>
    <button onclick="switchTab('prestar')" id="nav-prestar" class="flex flex-col items-center py-1 px-3 space-y-1">
      <i class="fa-solid fa-hand-holding-hand text-lg"></i>
      <span>Prestar</span>
    </button>
    <button onclick="switchTab('devolver')" id="nav-devolver" class="flex flex-col items-center py-1 px-3 space-y-1">
      <i class="fa-solid fa-rotate-left text-lg"></i>
      <span>Devolver</span>
    </button>
    <button onclick="switchTab('aula')" id="nav-aula" class="flex flex-col items-center py-1 px-3 space-y-1">
      <i class="fa-solid fa-calendar-days text-lg"></i>
      <span>Aula STEAM</span>
    </button>
  </nav>

  <script>
    let currentTab = 'scanner';
    let html5QrCode = null;

    function switchTab(tab) {
      if (html5QrCode && html5QrCode.isScanning) {
        html5QrCode.stop().catch(err => console.log(err));
      }
      currentTab = tab;
      document.querySelectorAll('nav button').forEach(b => b.classList.remove('nav-active'));
      document.getElementById('nav-' + tab).classList.add('nav-active');
      render();
    }

    function render() {
      const container = document.getElementById('app-content');
      if (currentTab === 'scanner') {
        container.innerHTML = `
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 text-center space-y-4">
            <h2 class="font-bold text-lg text-slate-100">Escáner de Equipos</h2>
            <p class="text-xs text-slate-400">Escanea la pegatina QR del equipo</p>
            
            <div id="reader" class="w-full bg-slate-950 rounded-xl border border-slate-800 h-64 overflow-hidden flex flex-col items-center justify-center relative">
              <i class="fa-solid fa-camera text-4xl text-slate-600 mb-2"></i>
              <p class="text-xs text-slate-500">Haz clic abajo para iniciar la cámara</p>
            </div>

            <div class="space-y-2 pt-2">
              <button onclick="startCamera()" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 py-3 rounded-xl text-sm font-bold shadow-lg shadow-sky-500/20">
                <i class="fa-solid fa-video mr-1.5"></i> Activar Cámara
              </button>
              
              <div class="flex space-x-2">
                <input type="file" id="qr-input-file" accept="image/*" class="hidden" onchange="scanImage(event)">
                <button onclick="document.getElementById('qr-input-file').click()" class="w-full bg-slate-800 hover:bg-slate-700 text-slate-200 py-2.5 rounded-xl text-sm font-medium border border-slate-700">
                  <i class="fa-solid fa-file-image mr-1 text-sky-400"></i> Seleccionar foto QR
                </button>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-800 text-left">
              <p class="text-[11px] font-semibold text-slate-400 uppercase mb-2">Simular lectura:</p>
              <div class="flex flex-wrap gap-1.5">
                <button onclick="onCodeScanned('CHROME-003')" class="px-2.5 py-1 bg-slate-800 text-sky-400 rounded text-xs font-mono border border-slate-700">CHROME-003</button>
                <button onclick="onCodeScanned('MIC-001')" class="px-2.5 py-1 bg-slate-800 text-sky-400 rounded text-xs font-mono border border-slate-700">MIC-001</button>
                <button onclick="onCodeScanned('PORT-001')" class="px-2.5 py-1 bg-slate-800 text-sky-400 rounded text-xs font-mono border border-slate-700">PORT-001</button>
              </div>
            </div>
          </div>
        `;
      } else if (currentTab === 'prestar') {
        container.innerHTML = `
          <div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3">
            <h2 class="font-bold text-lg">Nuevo Préstamo</h2>
            <div>
              <label class="text-xs text-slate-400 block mb-1">Código del Equipo</label>
              <input type="text" id="equipo-code" placeholder="Ej. CHROME-001" class="w-full bg-slate-950 border border-sky-500/50 text-sky-400 font-bold rounded-xl p-3 text-sm font-mono">
            </div>
            <div>
              <label class="text-xs text-slate-400 block mb-1">Docente / Profesor/a</label>
              <input type="text" id="docente-name" placeholder="Nombre del profesor/a" class="w-full bg-slate-950 border border-slate-800 rounded-xl p-3 text-sm focus:outline-none focus:border-sky-500">
            </div>
            <button onclick="confirmarPrestamo()" class="w-full bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold py-3 rounded-xl text-sm mt-2">
              Registrar Préstamo
            </button>
          </div>
        `;
      } else if (currentTab === 'devolver') {
        container.innerHTML = `<div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3"><h2 class="font-bold text-lg">Devoluciones Pendientes</h2><p class="text-xs text-slate-400 italic">No hay préstamos pendientes registrados.</p></div>`;
      } else if (currentTab === 'aula') {
        container.innerHTML = `<div class="bg-slate-900 border border-slate-800 rounded-2xl p-4 space-y-3"><h2 class="font-bold text-lg">Reserva Aula STEAM</h2><p class="text-xs text-slate-400">Tramo horario disponible.</p></div>`;
      }
    }

    function startCamera() {
      if (!html5QrCode) {
        html5QrCode = new Html5Qrcode("reader");
      }
      const config = { fps: 10, qrbox: { width: 220, height: 220 } };
      
      html5QrCode.start(
        { facingMode: "environment" },
        config,
        (decodedText) => onCodeScanned(decodedText),
        () => {}
      ).catch(err => {
        alert("No se pudo acceder a la cámara. Comprueba los permisos del iPad.");
      });
    }

    function scanImage(e) {
      if (!e.target.files || e.target.files.length === 0) return;
      if (!html5QrCode) {
        html5QrCode = new Html5Qrcode("reader");
      }
      html5QrCode.scanFile(e.target.files[0], true)
        .then(code => onCodeScanned(code))
        .catch(() => alert("No se pudo detectar el código QR en esta foto."));
    }

    function onCodeScanned(code) {
      if (html5QrCode && html5QrCode.isScanning) {
        html5QrCode.stop().then(() => redirectAndFill(code)).catch(() => redirectAndFill(code));
      } else {
        redirectAndFill(code);
      }
    }

    function redirectAndFill(code) {
      switchTab('prestar');
      setTimeout(() => {
        const inputCode = document.getElementById('equipo-code');
        const inputDocente = document.getElementById('docente-name');
        if (inputCode) inputCode.value = code;
        if (inputDocente) inputDocente.focus();
      }, 100);
    }

    function confirmarPrestamo() {
      const doc = document.getElementById('docente-name').value;
      const eq = document.getElementById('equipo-code').value;
      if (!doc || !
